#include <iostream>
#include <string>
#include <cstdlib>
#include <limits>
using namespace std;

// Node of the singly linked list
struct Passenger {
    int seatNo;
    string name;
    int age;
    string gender;
    Passenger* next;
};

class Train {
private:
    int totalSeats;
    int* seats;             // Dynamic array
    Passenger* head;        // Linked list head

public:
    // Constructor
    Train(int n) {
        totalSeats = n;
        seats = (int*)malloc(totalSeats * sizeof(int));
        head = nullptr;

        if (seats == nullptr) {
            cout << "Memory allocation failed!\n";
            exit(EXIT_FAILURE);
        }

        for (int i = 0; i < totalSeats; i++) {
            seats[i] = 0;   // All seats initially available
        }
    }

    // Book a ticket
    void bookTicket() {
        int seat = -1;

        // Find the first available seat
        for (int i = 0; i < totalSeats; i++) {
            if (seats[i] == 0) {
                seat = i + 1;
                break;
            }
        }

        if (seat == -1) {
            cout << "Sorry, all seats are booked!\n";
            return;
        }

        string name, gender;
        int age;

        cout << "Enter Name: ";
        getline(cin, name);

        cout << "Enter Age: ";
        if (!(cin >> age) || age <= 0) {
            cout << "Invalid age!\n";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return;
        }

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        cout << "Enter Gender (M/F): ";
        getline(cin, gender);

        // Create a new linked-list node
        Passenger* p = new Passenger;
        p->seatNo = seat;
        p->name = name;
        p->age = age;
        p->gender = gender;
        p->next = head;

        head = p;

        // Mark the seat as booked
        seats[seat - 1] = 1;

        cout << "Ticket booked! Seat No: " << seat << "\n";
    }

    // Cancel a ticket
    void cancelTicket() {
        int seat;
        cout << "Enter Seat Number to cancel: ";

        if (!(cin >> seat)) {
            cout << "Invalid input!\n";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return;
        }

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        if (seat < 1 || seat > totalSeats ||
            seats[seat - 1] == 0) {
            cout << "Invalid seat number or seat is available!\n";
            return;
        }

        Passenger* current = head;
        Passenger* previous = nullptr;

        // Search for the passenger node
        while (current != nullptr &&
               current->seatNo != seat) {
            previous = current;
            current = current->next;
        }

        if (current == nullptr) {
            cout << "Passenger record not found!\n";
            return;
        }

        // Remove the node from the linked list
        if (previous == nullptr) {
            head = current->next;
        } else {
            previous->next = current->next;
        }

        delete current;

        // Make the seat available again
        seats[seat - 1] = 0;

        cout << "Ticket cancelled successfully!\n";
    }

    // Display all seat statuses
    void viewTrainStatus() {
        cout << "\n--- Train Status ---\n";

        for (int i = 0; i < totalSeats; i++) {
            cout << "Seat " << i + 1 << ": ";

            if (seats[i] == 1) {
                cout << "Booked\n";
            } else {
                cout << "Available\n";
            }
        }
    }

    // Display all passengers
    void viewPassengerList() {
        Passenger* current = head;

        if (current == nullptr) {
            cout << "No passengers booked yet.\n";
            return;
        }

        cout << "\n--- Passenger List ---\n";

        while (current != nullptr) {
            cout << "Seat No: " << current->seatNo
                 << " | Name: " << current->name
                 << " | Age: " << current->age
                 << " | Gender: " << current->gender
                 << "\n";

            current = current->next;
        }
    }

    // Release all linked-list nodes
    void clearPassengers() {
        while (head != nullptr) {
            Passenger* temp = head;
            head = head->next;
            delete temp;
        }
    }

    // Destructor: release allocated memory
    ~Train() {
        clearPassengers();
        free(seats);
    }
};

int main() {
    Train train(30);
    int choice;

    do {
        cout << "\n===== RAILWAY RESERVATION SYSTEM =====\n";
        cout << "1. Book Ticket\n";
        cout << "2. Cancel Ticket\n";
        cout << "3. View Train Status\n";
        cout << "4. View Passenger List\n";
        cout << "5. Exit\n";
        cout << "Enter your choice: ";

        if (!(cin >> choice)) {
            cout << "Invalid input! Exiting program.\n";
            break;
        }

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        switch (choice) {
            case 1:
                train.bookTicket();
                break;

            case 2:
                train.cancelTicket();
                break;

            case 3:
                train.viewTrainStatus();
                break;

            case 4:
                train.viewPassengerList();
                break;

            case 5:
                cout << "Exiting Railway Reservation System.\n";
                break;

            default:
                cout << "Invalid choice! Please try again.\n";
        }

    } while (choice != 5);

    return 0;
}
