#include<iostream>
using namespace std;
class node {
public:
    int data;
    node*next;

node(int val){
  data= val;
  next= nullptr;  
}

};
class list{
    node*head;
    node*tail;
public:
    list(){
        head=tail=nullptr;
        
    }
void push_front(int val){
    node* newnode= new node(val);
    if(head==nullptr ){
        head=tail=newnode;
        return;
    }
    else{
        newnode->next=head;
        head=newnode;
    }
    
}
    void pop_back(){
        if(head==nullptr){
            return;
        }
        else{
            node* temp=head;
            while(temp->next!=tail){
            temp=temp->next;
            
        }
           temp->next=nullptr;
            delete tail;
             tail=temp;
        
    }
}
    void print(){
        node* temp=head;
        while(temp!= nullptr){
            cout<<temp->data<<"->";
            temp=temp->next;
        }
        cout<<"null"<<endl;
    
    } 
};
int main (){
    list ll;
    ll.push_front(4);
    ll.push_front(8);
    ll.push_front(9);
    ll.pop_back();

    ll.print();

    return 0;
    
    
    
}



